@page
@model IndexModel

<!DOCTYPE html>
<html lang="ru">

<head>
    <title>Домашняя страница </title>
</head>

<body>

    <section id="travels">
        <header id="header-travels">
            <div class="flex-header-gray">
                <h1>НОВОЕ В БЛОГЕ</h1>
                <div class="flex-header-border"></div>
            </div>
        </header>
        <div class="flex-section-travels">
            <div class="flex-section-list">
                @foreach (var travel in Model.TravelsList.GetAll())
                    {
                        <div class="flex-item-list">
                            <div class="item-title">
                               <h3>@travel.title</h3>
                            <form method="post" asp-page-handler="Delete">
                                <input type="hidden" name="id" value="@travel.id" />
                                <input type="hidden" name="type" value="travels" />
                                <button type="submit" class="delete-button">🗑️</button>
                            </form>
                            </div>

                            <h5>@travel.description</h5>
                            <img src="@travel.image" alt="@travel.title" />
                            <p>@travel.date.ToShortDateString()</p>
                        </div>
                    }
            </div>
        </div>
    </section>

    <section id="countries">
        <header id="header-countries">
            <div class="flex-header-base">
                <h1>CТРАНЫ</h1>
                <div class="flex-header-border"></div>
            </div>
        </header>
        <div class="flex-section-countries">
            <div class="flex-section-list">
                @foreach (var country in Model.CountriesList.GetAll())
                {
                    <div class="flex-item-list">
                        <div class="item-title">
                            <h3>@country.title</h3>
                            <form method="post" asp-page-handler="Delete">
                                <input type="hidden" name="id" value="@country.id" />
                                <input type="hidden" name="type" value="countries" />
                                <button type="submit" class="delete-button">🗑️</button>
                            </form>
                        </div>
                        <h5>@country.description</h5>
                        <img src="@country.image" alt="@country.title" />
                        <p>@country.date.ToShortDateString()</p>
                    </div>
                }
            </div>
         </div>
    </section>

    <section id="about">
        <header id="header-about">
            <div class="flex-header-gray">
                <h1>ОБО МНЕ</h1>
            </div>
        </header>
        <div class="flex-section-about">
            <div class="flex-section-about-image">
                <img src="\Data\Images\imgAboutMe.png" alt="Здесь должен был быть я" class="about-image" />
            </div>
            <div class="flex-section-about-item">
                <p>
                    Меня зовут Иванов Иван, и я начинающий путешественник. Совсем недавно
                    я открыл для себя страсть к исследованию нового и неизведанного,
                    и теперь мое сердце переполняет желание делиться своими приключениями
                    со всем миром.
                </p>
                <p>
                    Делясь своими впечатлениями в блоге, я надеюсь вдохновить других людей на
                    путешествия. Мне хочется показать, что открывать для себя новые
                    горизонты - это увлекательно, познавательно и, самое главное,
                    доступно каждому.
                </p>
                <p>
                    Пусть мои рассказы станут для вас отправной точкой
                    в мир приключений!
                </p>
            </div>
        </div>
    </section>

    <section id="tours">
        <header id="header-tours">
            <div class="flex-header-base">
                <h1>Туры</h1>
                <div class="flex-header-border"></div>
            </div>
        </header>
        <div class="flex-section-tours">
            <div class="flex-section-list">
                @foreach (var tour in Model.ToursList.GetAll())
                {
                    <div class="flex-item-list">
                        <div class="item-title">
                            <h3>@tour.title</h3>
                            <form method="post" asp-page-handler="Delete">
                                <input type="hidden" name="id" value="@tour.id" />
                                <input type="hidden" name="type" value="tours" />
                                <button type="submit" class="delete-button">🗑️</button>
                            </form>
                        </div>
                        <h5>@tour.description</h5>
                        <img src="@tour.image" alt="@tour.title" />
                        <p>@tour.date.ToShortDateString()</p>
                    </div>
                }
            </div>
        </div>
    </section>

</body>

</html>
