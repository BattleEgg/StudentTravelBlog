<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Блог Ивана Иванова</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,opsz,wght@0,18..144,300..900;1,18..144,300..900&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="~/css/styles.css" />

</head>
<body>
    <nav>
        <div class="flex-nav-bar">
            <div class="flex-nav-item">
                <a href="/index#travels">ПУТЕШЕСТВИЯ</a>
            </div>
            <div class="flex-nav-item">
                <a href="/index#countries">СТРАНЫ</a>
            </div>
            <div class="flex-nav-item">
                <a href="/index#about">ОБО МНЕ</a>
            </div>
            <div class="flex-nav-item">
                <a href="/index#tours">ТУРЫ</a>
            </div>
            <div class="flex-nav-item">
                <a href="/admin">АДМИН</a>
            </div>
        </div>
    </nav>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
